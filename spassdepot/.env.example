# Kopieren nach .env und ausfüllen. Die Datei .env wird nie eingecheckt.

# Reihenfolge = Priorität der Kursanbieter; bei Ausfall wird automatisch gewechselt.
# Anbieter ohne Schlüssel werden übersprungen. "demo" liefert simulierte Kurse zum Ausprobieren.
PROVIDER_ORDER=finnhub,twelvedata,yfinance,alphavantage

FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optionaler Passwortschutz, falls die App nicht nur lokal läuft (leer = kein Login)
APP_PASSWORD=
# Zufälliger Wert zum Signieren des Session-Cookies (bei gesetztem APP_PASSWORD empfohlen)
SESSION_SECRET=
# 1, wenn die App über HTTPS ausgeliefert wird (Cookie nur über HTTPS)
COOKIE_SECURE=0

# Standard: SQLite-Datei unter data/app.db
# DATABASE_URL=sqlite:///data/app.db
# Hintergrunddienste abschalten (z. B. für Tests): 0
# LIVE_AKTIV=1
# JOBS_AKTIV=1
